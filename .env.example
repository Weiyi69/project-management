# Create the orbit_db database and orbit_user login in pgAdmin 4 first.
# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL="postgresql://orbit_user:replace-with-local-password@localhost:5432/orbit_db?schema=public"

FRONTEND_URL="http://localhost:5173"
PORT=3000
NODE_ENV="development"

# Generate a random secret with: openssl rand -hex 32
OTP_PEPPER=replace-with-at-least-32-random-bytes

# Backend-only SMTP settings for verification, password reset, and invitations.
# Gmail: enable 2-Step Verification and create an App Password (see EMAIL_AUTH.md).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASSWORD=your-16-character-gmail-app-password
# SMTP_FROM="ORBIT <your-gmail-address@gmail.com>"

# Optional, explicitly opt-in real delivery test. Never set in regular test runs.
# RUN_GMAIL_SMOKE_TEST=true
# GMAIL_SMOKE_TEST_RECIPIENT=mailbox-you-control@example.com
