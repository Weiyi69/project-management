# Create the orbit_db database and orbit_user login in pgAdmin 4 first.
# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL="postgresql://orbit_user:replace-with-local-password@localhost:5432/orbit_db?schema=public"

FRONTEND_URL="http://localhost:5173"
PORT=3000
NODE_ENV="development"

# Optional SMTP settings for workspace invitation emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM="ORBIT <no-reply@example.com>"
